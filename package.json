{
  "name": "webgpu-bench-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "rimraf dist packages/**/dist",
    "clean:all": "pnpm clean && rimraf node_modules packages/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "tsc -b",
    "test": "vitest run --project 'core (node)' --project 'core (browser-chromium)' --project cli --coverage && node scripts/check-coverage.mjs",
    "test:all": "vitest run",
    "size": "size-limit",
    "release": "semantic-release",
    "test:workflow": "node --test scripts/workflow.test.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.36",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.19.2",
    "@visulima/yaml": "1.0.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "size-limit": [
    {
      "name": "Core compiled JavaScript (Brotli)",
      "path": "packages/core/dist/**/*.js",
      "limit": "100 kB"
    },
    {
      "name": "CLI compiled JavaScript (Brotli, dependencies excluded)",
      "path": "packages/cli/dist/**/*.js",
      "limit": "20 kB"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
