{
  "name": "webgpu-bench-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter webgpu-bench --filter website dev",
    "start": "pnpm --filter website start",
    "clean": "rimraf dist packages/**/dist packages/**/.output packages/**/.nitro packages/**/.tanstack",
    "clean:all": "pnpm clean && rimraf node_modules packages/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "tsc -b",
    "test": "pnpm -r test",
    "make-release": "node scripts/make-release.mjs packages/webgpu-bench"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.62.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}
