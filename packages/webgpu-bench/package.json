  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/webgpu-profiler.git",
    "directory": "packages/webgpu-bench"
  },
  "files": ["dist"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
